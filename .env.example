# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-32-char-string

# JWT
JWT_SECRET_KEY=change-me-to-another-random-secret
JWT_EXPIRY_HOURS=24

# Database
DATABASE_PATH=backend/database/jobguard.db

# CORS — set to your Live Server origin
CORS_ORIGIN=http://127.0.0.1:5500

# ML
SAVED_MODELS_DIR=ml/saved_models
DATA_PATH=ml/data/fake_job_postings.csv
